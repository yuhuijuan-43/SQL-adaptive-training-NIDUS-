# ===== SQL 自适应训练平台 · 部署环境变量 =====
# 拷到 .env 后逐项填写；敏感值不要提交到 git

# Flask session cookie 签名密钥（≥32 位随机字符；不设会导致 OAuth state 跨重启失效，
# 且每次重启都会重置 session，全员被强制下线）
FLASK_SECRET_KEY=please-replace-with-32-char-random-secret-string

# ===== GitHub OAuth（不启用 GitHub 登录可留空）=====
# 在 https://github.com/settings/developers 创建 OAuth App：
#   Homepage URL        : http://47.114.44.138:5000
#   Authorization URL  : http://47.114.44.138:5000/api/oauth/github/callback
# 创建后把 Client ID / Secret 填到这里；服务端 oauth.py 会优先读环境变量，回落到 backend/oauth_config.json
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ===== 数据治理阈值（按需调整）=====
# user_progress 保险丝阈值：超过 N 行才压缩重复答对行
USER_PROGRESS_MAX_ROWS=100000
# 每 N 次答题登记后检查一次行数（0 = 关闭检查）
USER_PROGRESS_CHECK_EVERY=500
# backend/backups/ 保留最近 N 份自动备份（每份约 11MB）
DB_BACKUP_KEEP=20