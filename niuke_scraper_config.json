{
  "name": "牛客SQL题库爬取",
  "cookie_source": "chrome",
  "cookie_domain": "www.nowcoder.com",
  "rate_limit": 0.5,
  "retry": 3,
  "output_dir": "./scraped_data",
  "resume_file": "./scraped_data/progress.json",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
    "Referer": "https://www.nowcoder.com/exam/oj"
  },

  "steps": [
    {
      "_comment": "步骤1: 获取题单列表。将 topicId 换成实际值",
      "name": "获取SQL热题列表",
      "type": "api_list",
      "url": "https://www.nowcoder.com/api/questiontraining/coding/getTopicQuestion?topicId=82&page=1",
      "method": "GET",
      "result_path": "data.questions",
      "item_id_field": "questionNo",
      "save_as": "list_SQL热题.json"
    },
    {
      "_comment": "步骤2: 批量抓取题目详情",
      "name": "抓取题目内容",
      "type": "page_detail",
      "url_source": "list_SQL热题.json",
      "url_field": "url",
      "detail_dir": "./scraped_data/SQL热题_详情",
      "save_format": "folders",
      "extractors": [
        {"name": "title",        "selector": "h1.subject-title", "attr": "text"},
        {"name": "description",  "selector": "div.subject-describe", "attr": "text"},
        {"name": "sql_schema",   "regex": "CREATE TABLE[\\s\\S]*?(?=INSERT|$)", "regex_group": 0},
        {"name": "sql_data",     "regex": "INSERT INTO[\\s\\S]*?(?=</pre>|$)", "regex_group": 0}
      ]
    }
  ]
}
